# Server-only key for live uploads. Synthetic samples do not require it.
# Put your real key in .env.local, which is git-ignored. This file is committed.
# Free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional; defaults to gemini-3.6-flash.
EXTRACTION_MODEL=gemini-3.6-flash

# Optional per-IP throttles. A letter costs one call when its PDF text layer is
# usable, two when it needs the vision pass, three if extraction retries.
EXTRACTION_MAX_PER_MINUTE=2
EXTRACTION_MAX_CONCURRENT=2
